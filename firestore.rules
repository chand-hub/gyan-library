rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Reusable Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedEmail() && request.auth.token.email == 'educationrevolution90@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdminEmail() ||
        (isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function getRoleDoc() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }

    function hasRoleDoc() {
      return isVerifiedEmail() && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function isManagerOrAdmin() {
      return isAdmin() || (hasRoleDoc() && getRoleDoc().active == true && getRoleDoc().role in ['admin', 'manager']);
    }

    function isStaffOrAbove() {
      return isManagerOrAdmin() || (hasRoleDoc() && getRoleDoc().active == true && getRoleDoc().role in ['admin', 'manager', 'staff']);
    }

    function isNonEmptyString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Existing Library Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'studentDocId', 'staffDocId', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isNonEmptyString(data.email, 3, 200)
        && isNonEmptyString(data.displayName, 1, 120)
        && data.role in ['student', 'staff', 'manager', 'admin']
        && data.status in ['active', 'inactive', 'blocked']
        && (!('studentDocId' in data) || isOptionalString(data.studentDocId, 128))
        && (!('staffDocId' in data) || isOptionalString(data.staffDocId, 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && isNonEmptyString(data.email, 3, 200)
        && data.createdAt is timestamp;
    }

    function isValidUserRoleAssignment(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'permissions', 'active', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'permissions', 'active', 'updatedAt'])
        && isValidId(data.uid)
        && isNonEmptyString(data.email, 3, 200)
        && data.role in ['admin', 'manager', 'staff', 'student']
        && data.permissions is list && data.permissions.size() <= 20
        && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 60))
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['uid', 'studentCode', 'fullName', 'mobile', 'email', 'fatherName', 'address', 'emergencyContact', 'membershipStatus', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'studentCode', 'fullName', 'mobile', 'email', 'fatherName', 'address', 'emergencyContact', 'profilePhotoUrl', 'idDocumentUrl', 'seatId', 'seatCode', 'membershipId', 'membershipPlanName', 'membershipStatus', 'membershipExpiry', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.uid, 1, 128)
        && isNonEmptyString(data.studentCode, 4, 24)
        && data.studentCode.matches('^VL[0-9]{4,12}$')
        && isNonEmptyString(data.fullName, 2, 120)
        && isNonEmptyString(data.mobile, 7, 20)
        && isNonEmptyString(data.email, 3, 200)
        && isNonEmptyString(data.fatherName, 2, 120)
        && isNonEmptyString(data.address, 3, 400)
        && isNonEmptyString(data.emergencyContact, 7, 30)
        && (!('profilePhotoUrl' in data) || isOptionalString(data.profilePhotoUrl, 1000))
        && (!('idDocumentUrl' in data) || isOptionalString(data.idDocumentUrl, 1000))
        && (!('seatId' in data) || isOptionalString(data.seatId, 128))
        && (!('seatCode' in data) || isOptionalString(data.seatCode, 16))
        && (!('membershipId' in data) || isOptionalString(data.membershipId, 128))
        && (!('membershipPlanName' in data) || isOptionalString(data.membershipPlanName, 100))
        && data.membershipStatus in ['active', 'expired', 'pending', 'none']
        && (!('membershipExpiry' in data) || isOptionalString(data.membershipExpiry, 40))
        && data.status in ['active', 'inactive', 'blocked']
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['staffCode', 'fullName', 'email', 'mobile', 'role', 'permissions', 'shift', 'monthlySalary', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'staffCode', 'fullName', 'email', 'mobile', 'role', 'permissions', 'shift', 'monthlySalary', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && (!('uid' in data) || isOptionalString(data.uid, 128))
        && isNonEmptyString(data.staffCode, 2, 24)
        && isNonEmptyString(data.fullName, 2, 120)
        && isNonEmptyString(data.email, 3, 200)
        && isNonEmptyString(data.mobile, 7, 20)
        && data.role in ['staff', 'manager']
        && data.permissions is list && data.permissions.size() <= 20
        && (data.permissions.size() == 0 || (data.permissions[0] is string && data.permissions[0].size() <= 60))
        && isNonEmptyString(data.shift, 2, 60)
        && data.monthlySalary is number && data.monthlySalary >= 0 && data.monthlySalary <= 10000000
        && data.status in ['active', 'inactive']
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMembershipPlan(data) {
      return data.keys().hasAll(['name', 'durationDays', 'price', 'timings', 'seatAccess', 'facilities', 'terms', 'active', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'durationDays', 'price', 'timings', 'seatAccess', 'facilities', 'terms', 'active', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 2, 100)
        && data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 3650
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && isNonEmptyString(data.timings, 2, 100)
        && isNonEmptyString(data.seatAccess, 2, 120)
        && data.facilities is list && data.facilities.size() <= 15
        && (data.facilities.size() == 0 || (data.facilities[0] is string && data.facilities[0].size() <= 100))
        && isOptionalString(data.terms, 1000)
        && data.active is bool
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMembership(data) {
      return data.keys().hasAll(['studentDocId', 'studentUid', 'studentCode', 'studentName', 'planId', 'planName', 'amount', 'startDate', 'expiryDate', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentDocId', 'studentUid', 'studentCode', 'studentName', 'planId', 'planName', 'amount', 'startDate', 'expiryDate', 'status', 'paymentId', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.studentDocId, 1, 128)
        && isNonEmptyString(data.studentUid, 1, 128)
        && isNonEmptyString(data.studentCode, 4, 24)
        && isNonEmptyString(data.studentName, 2, 120)
        && isNonEmptyString(data.planId, 1, 128)
        && isNonEmptyString(data.planName, 2, 100)
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000
        && isNonEmptyString(data.startDate, 4, 40)
        && isNonEmptyString(data.expiryDate, 4, 40)
        && data.status in ['active', 'expired', 'pending', 'cancelled']
        && (!('paymentId' in data) || isOptionalString(data.paymentId, 128))
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSeat(data) {
      return data.keys().hasAll(['seatCode', 'zone', 'rowLabel', 'colIndex', 'status', 'isDemo', 'updatedAt'])
        && data.keys().hasOnly(['seatCode', 'zone', 'rowLabel', 'colIndex', 'status', 'assignedStudentDocId', 'assignedStudentUid', 'assignedStudentCode', 'shift', 'isDemo', 'updatedAt'])
        && isNonEmptyString(data.seatCode, 2, 16)
        && isNonEmptyString(data.zone, 2, 60)
        && isNonEmptyString(data.rowLabel, 1, 8)
        && data.colIndex is int && data.colIndex >= 1 && data.colIndex <= 100
        && data.status in ['available', 'occupied', 'reserved', 'maintenance']
        && (!('assignedStudentDocId' in data) || isOptionalString(data.assignedStudentDocId, 128))
        && (!('assignedStudentUid' in data) || isOptionalString(data.assignedStudentUid, 128))
        && (!('assignedStudentCode' in data) || isOptionalString(data.assignedStudentCode, 24))
        && (!('shift' in data) || isOptionalString(data.shift, 60))
        && data.isDemo is bool
        && data.updatedAt is timestamp;
    }

    function isValidSeatBooking(data) {
      return data.keys().hasAll(['seatId', 'seatCode', 'studentDocId', 'studentUid', 'studentCode', 'studentName', 'bookingType', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['seatId', 'seatCode', 'studentDocId', 'studentUid', 'studentCode', 'studentName', 'bookingType', 'status', 'notes', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.seatId, 1, 128)
        && isNonEmptyString(data.seatCode, 2, 16)
        && isNonEmptyString(data.studentDocId, 1, 128)
        && isNonEmptyString(data.studentUid, 1, 128)
        && isNonEmptyString(data.studentCode, 4, 24)
        && isNonEmptyString(data.studentName, 2, 120)
        && data.bookingType in ['new', 'change']
        && data.status in ['pending', 'approved', 'rejected', 'cancelled', 'released']
        && (!('notes' in data) || isOptionalString(data.notes, 400))
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['studentDocId', 'studentUid', 'studentCode', 'studentName', 'date', 'checkInTime', 'durationMinutes', 'method', 'isLate', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentDocId', 'studentUid', 'studentCode', 'studentName', 'date', 'checkInTime', 'checkOutTime', 'durationMinutes', 'method', 'isLate', 'markedBy', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.studentDocId, 1, 128)
        && isNonEmptyString(data.studentUid, 1, 128)
        && isNonEmptyString(data.studentCode, 4, 24)
        && isNonEmptyString(data.studentName, 2, 120)
        && isNonEmptyString(data.date, 8, 20)
        && isNonEmptyString(data.checkInTime, 4, 40)
        && (!('checkOutTime' in data) || isOptionalString(data.checkOutTime, 40))
        && data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 1440
        && data.method in ['qr', 'manual', 'id']
        && data.isLate is bool
        && (!('markedBy' in data) || isOptionalString(data.markedBy, 128))
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookCategory(data) {
      return data.keys().hasAll(['name', 'shelfRange', 'createdAt'])
        && data.keys().hasOnly(['name', 'description', 'shelfRange', 'createdAt'])
        && isNonEmptyString(data.name, 2, 80)
        && (!('description' in data) || isOptionalString(data.description, 300))
        && isNonEmptyString(data.shelfRange, 1, 40)
        && data.createdAt is timestamp;
    }

    function isValidBook(data) {
      return data.keys().hasAll(['title', 'author', 'isbn', 'categoryName', 'totalCopies', 'availableCopies', 'shelfNumber', 'publicationYear', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'author', 'publisher', 'isbn', 'categoryId', 'categoryName', 'totalCopies', 'availableCopies', 'shelfNumber', 'publicationYear', 'coverUrl', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.title, 1, 200)
        && isNonEmptyString(data.author, 1, 150)
        && (!('publisher' in data) || isOptionalString(data.publisher, 150))
        && isNonEmptyString(data.isbn, 3, 32)
        && (!('categoryId' in data) || isOptionalString(data.categoryId, 128))
        && isNonEmptyString(data.categoryName, 2, 80)
        && data.totalCopies is int && data.totalCopies >= 0 && data.totalCopies <= 10000
        && data.availableCopies is int && data.availableCopies >= 0 && data.availableCopies <= data.totalCopies
        && isNonEmptyString(data.shelfNumber, 1, 32)
        && data.publicationYear is int && data.publicationYear >= 1800 && data.publicationYear <= 2100
        && (!('coverUrl' in data) || isOptionalString(data.coverUrl, 1000))
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookIssue(data) {
      return data.keys().hasAll(['bookId', 'bookTitle', 'studentDocId', 'studentUid', 'studentCode', 'studentName', 'fineAmount', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['bookId', 'bookTitle', 'studentDocId', 'studentUid', 'studentCode', 'studentName', 'issueDate', 'dueDate', 'returnDate', 'fineAmount', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.bookId, 1, 128)
        && isNonEmptyString(data.bookTitle, 1, 200)
        && isNonEmptyString(data.studentDocId, 1, 128)
        && isNonEmptyString(data.studentUid, 1, 128)
        && isNonEmptyString(data.studentCode, 4, 24)
        && isNonEmptyString(data.studentName, 2, 120)
        && (!('issueDate' in data) || isOptionalString(data.issueDate, 40))
        && (!('dueDate' in data) || isOptionalString(data.dueDate, 40))
        && (!('returnDate' in data) || isOptionalString(data.returnDate, 40))
        && data.fineAmount is number && data.fineAmount >= 0 && data.fineAmount <= 100000
        && data.status in ['requested', 'issued', 'returned', 'overdue', 'rejected']
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['receiptNumber', 'studentDocId', 'studentUid', 'studentCode', 'studentName', 'planName', 'amount', 'method', 'status', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['receiptNumber', 'studentDocId', 'studentUid', 'studentCode', 'studentName', 'planId', 'planName', 'amount', 'method', 'status', 'razorpayOrderId', 'razorpayPaymentId', 'razorpaySignature', 'notes', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.receiptNumber, 3, 40)
        && isNonEmptyString(data.studentDocId, 1, 128)
        && isNonEmptyString(data.studentUid, 1, 128)
        && isNonEmptyString(data.studentCode, 4, 24)
        && isNonEmptyString(data.studentName, 2, 120)
        && (!('planId' in data) || isOptionalString(data.planId, 128))
        && isNonEmptyString(data.planName, 2, 100)
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000
        && data.method in ['razorpay_upi', 'razorpay_card', 'razorpay_netbanking', 'cash', 'upi_offline']
        && data.status in ['verified', 'pending', 'failed', 'refunded']
        && (!('razorpayOrderId' in data) || isOptionalString(data.razorpayOrderId, 128))
        && (!('razorpayPaymentId' in data) || isOptionalString(data.razorpayPaymentId, 128))
        && (!('razorpaySignature' in data) || isOptionalString(data.razorpaySignature, 256))
        && (!('notes' in data) || isOptionalString(data.notes, 400))
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['title', 'category', 'amount', 'expenseDate', 'recordedBy', 'isDemo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'category', 'amount', 'expenseDate', 'notes', 'recordedBy', 'isDemo', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.title, 2, 150)
        && data.category in ['electricity', 'rent', 'internet', 'salary', 'maintenance', 'furniture', 'other']
        && data.amount is number && data.amount >= 0 && data.amount <= 10000000
        && isNonEmptyString(data.expenseDate, 8, 20)
        && (!('notes' in data) || isOptionalString(data.notes, 400))
        && isNonEmptyString(data.recordedBy, 1, 128)
        && data.isDemo is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientUid', 'type', 'title', 'message', 'read', 'channel', 'createdAt'])
        && data.keys().hasOnly(['recipientUid', 'type', 'title', 'message', 'read', 'channel', 'createdAt'])
        && isNonEmptyString(data.recipientUid, 1, 128)
        && data.type in ['membership_expiry', 'payment_confirmation', 'payment_pending', 'seat_allocation', 'seat_change', 'attendance_confirmation', 'book_return', 'announcement']
        && isNonEmptyString(data.title, 2, 150)
        && isNonEmptyString(data.message, 2, 600)
        && data.read is bool
        && data.channel in ['in_app', 'whatsapp', 'email', 'sms']
        && data.createdAt is timestamp;
    }

    function isValidEnquiry(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 2, 120)
        && isNonEmptyString(data.email, 3, 200)
        && isNonEmptyString(data.phone, 7, 20)
        && isNonEmptyString(data.subject, 2, 150)
        && isNonEmptyString(data.message, 5, 1000)
        && data.status in ['new', 'contacted', 'resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'priority', 'published', 'createdAt'])
        && data.keys().hasOnly(['title', 'body', 'priority', 'published', 'createdAt'])
        && isNonEmptyString(data.title, 2, 160)
        && isNonEmptyString(data.body, 2, 1000)
        && data.priority in ['normal', 'important']
        && data.published is bool
        && data.createdAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'category', 'imageUrl', 'caption', 'sortOrder', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'imageUrl', 'caption', 'sortOrder', 'createdAt'])
        && isNonEmptyString(data.title, 2, 120)
        && isNonEmptyString(data.category, 2, 60)
        && isNonEmptyString(data.imageUrl, 3, 1000)
        && isOptionalString(data.caption, 300)
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.createdAt is timestamp;
    }

    function isValidLibrarySettings(data) {
      return data.keys().hasAll(['libraryName', 'tagline', 'address', 'phone', 'whatsapp', 'email', 'openingHours', 'is24HourAccess', 'mapLat', 'mapLng', 'facilities', 'updatedAt'])
        && data.keys().hasOnly(['libraryName', 'tagline', 'address', 'phone', 'whatsapp', 'email', 'openingHours', 'is24HourAccess', 'mapLat', 'mapLng', 'mapUrl', 'ratingText', 'facilities', 'termsText', 'privacyText', 'razorpayEnabled', 'whatsappConfigured', 'emailConfigured', 'smsConfigured', 'updatedAt'])
        && isNonEmptyString(data.libraryName, 2, 120)
        && isNonEmptyString(data.tagline, 2, 200)
        && isNonEmptyString(data.address, 3, 300)
        && isNonEmptyString(data.phone, 5, 40)
        && isNonEmptyString(data.whatsapp, 5, 30)
        && isNonEmptyString(data.email, 3, 200)
        && isNonEmptyString(data.openingHours, 2, 120)
        && data.is24HourAccess is bool
        && data.mapLat is number && data.mapLng is number
        && (!('mapUrl' in data) || isOptionalString(data.mapUrl, 500))
        && (!('ratingText' in data) || isOptionalString(data.ratingText, 100))
        && data.facilities is list && data.facilities.size() <= 20
        && (data.facilities.size() == 0 || (data.facilities[0] is string && data.facilities[0].size() <= 120))
        && (!('termsText' in data) || isOptionalString(data.termsText, 4000))
        && (!('privacyText' in data) || isOptionalString(data.privacyText, 4000))
        && (!('razorpayEnabled' in data) || data.razorpayEnabled is bool)
        && (!('whatsappConfigured' in data) || data.whatsappConfigured is bool)
        && (!('emailConfigured' in data) || data.emailConfigured is bool)
        && (!('smsConfigured' in data) || data.smsConfigured is bool)
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'actorRole', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'actorRole', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && isNonEmptyString(data.actorUid, 1, 128)
        && isNonEmptyString(data.actorEmail, 3, 200)
        && isNonEmptyString(data.actorRole, 2, 40)
        && isNonEmptyString(data.action, 2, 120)
        && isNonEmptyString(data.targetType, 2, 80)
        && isNonEmptyString(data.targetId, 1, 128)
        && isOptionalString(data.details, 500)
        && data.createdAt is timestamp;
    }

    // Competitive Examination & AI Learning Blueprints
    function isValidExamCategory(data) {
      return data.keys().hasAll(['name', 'categoryGroup', 'code', 'defaultDurationMinutes', 'marksPerCorrect', 'negativeMarks', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'categoryGroup', 'code', 'defaultDurationMinutes', 'marksPerCorrect', 'negativeMarks', 'description', 'active', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 2, 100)
        && isNonEmptyString(data.categoryGroup, 2, 80)
        && isNonEmptyString(data.code, 2, 32)
        && data.defaultDurationMinutes is int && data.defaultDurationMinutes >= 5 && data.defaultDurationMinutes <= 360
        && data.marksPerCorrect is number && data.marksPerCorrect >= 0.5 && data.marksPerCorrect <= 20
        && data.negativeMarks is number && data.negativeMarks >= 0 && data.negativeMarks <= 10
        && isOptionalString(data.description, 400)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExamSubject(data) {
      return data.keys().hasAll(['examName', 'name', 'active', 'createdAt'])
        && data.keys().hasOnly(['examName', 'name', 'active', 'createdAt'])
        && isNonEmptyString(data.examName, 2, 100)
        && isNonEmptyString(data.name, 2, 100)
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidExamChapter(data) {
      return data.keys().hasAll(['examName', 'subjectName', 'name', 'topics', 'active', 'createdAt'])
        && data.keys().hasOnly(['examName', 'subjectName', 'name', 'topics', 'active', 'createdAt'])
        && isNonEmptyString(data.examName, 2, 100)
        && isNonEmptyString(data.subjectName, 2, 100)
        && isNonEmptyString(data.name, 2, 140)
        && data.topics is list && data.topics.size() <= 40
        && (data.topics.size() == 0 || (data.topics[0] is string && data.topics[0].size() <= 140))
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function isValidExamQuestion(data) {
      return data.keys().hasAll(['questionCode', 'examName', 'examCategory', 'subject', 'chapter', 'topic', 'questionText', 'options', 'difficulty', 'examYear', 'source', 'language', 'verificationStatus', 'fingerprint', 'normalizedText', 'answerSeal', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['questionCode', 'examName', 'examCategory', 'subject', 'chapter', 'topic', 'questionText', 'options', 'difficulty', 'examYear', 'examShift', 'source', 'sourceDocumentId', 'language', 'verificationStatus', 'published', 'usageCount', 'hasDiagramOrTable', 'diagramDescription', 'fingerprint', 'normalizedText', 'answerSeal', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.questionCode, 2, 40)
        && isNonEmptyString(data.examName, 2, 100)
