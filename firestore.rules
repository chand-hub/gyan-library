    // Existing Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isStaffOrAbove());
      allow list: if isStaffOrAbove() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isValidId(userId) && isVerifiedEmail() && isValidUserProfile(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time
        && (isAdmin() || (isOwner(userId) && incoming().uid == request.auth.uid && incoming().role == 'student' && incoming().status == 'active'));
      allow update: if isValidId(userId) && isVerifiedEmail() && isValidUserProfile(incoming())
        && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time
        && incoming().uid == existing().uid
        && (isAdmin() || (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'studentDocId', 'updatedAt']) && incoming().role == existing().role && incoming().status == existing().status));
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{userId} {
