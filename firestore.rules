        && data.sendWindowStartHour is int && data.sendWindowStartHour >= 0 && data.sendWindowStartHour <= 23
        && data.sendWindowEndHour is int && data.sendWindowEndHour >= 0 && data.sendWindowEndHour <= 24
        && data.triggerOnDueOrOverdueOnly is bool
        && isNonEmptyString(data.templateName, 1, 120)
        && isNonEmptyString(data.languageCode, 2, 20)
