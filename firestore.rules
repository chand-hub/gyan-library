        && data.keys().hasOnly(['autoReminderEnabled', 'globalPaused', 'reminderIntervalHours', 'timezone', 'sendWindowStartHour', 'sendWindowEndHour', 'triggerOnDueOrOverdueOnly', 'templateName', 'languageCode', 'messageTemplatePreview', 'updatedAt'])
        && data.autoReminderEnabled is bool
