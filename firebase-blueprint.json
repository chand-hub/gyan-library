{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account linking Firebase Auth UID to role and student/staff identity.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "staff", "manager", "admin"] },
        "studentDocId": { "type": "string", "maxLength": 128 },
        "staffDocId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "inactive", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Trusted administrator lookup record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserRoleAssignment": {
      "title": "UserRoleAssignment",
      "description": "Server-trusted RBAC role and granular permissions record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "manager", "staff", "student"] },
        "permissions": { "type": "array" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "permissions", "active", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Library student/member profile with unique VL student ID and PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentCode": { "type": "string", "pattern": "^VL[0-9]{4,12}$", "maxLength": 24 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "mobile": { "type": "string", "minLength": 7, "maxLength": 20 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "fatherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "address": { "type": "string", "minLength": 3, "maxLength": 400 },
        "emergencyContact": { "type": "string", "minLength": 7, "maxLength": 30 },
        "profilePhotoUrl": { "type": "string", "maxLength": 1000 },
        "idDocumentUrl": { "type": "string", "maxLength": 1000 },
        "seatId": { "type": "string", "maxLength": 128 },
        "seatCode": { "type": "string", "maxLength": 16 },
        "membershipId": { "type": "string", "maxLength": 128 },
        "membershipPlanName": { "type": "string", "maxLength": 100 },
        "membershipStatus": { "type": "string", "enum": ["active", "expired", "pending", "none"] },
        "membershipExpiry": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "inactive", "blocked"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "studentCode", "fullName", "mobile", "email", "fatherName", "address", "emergencyContact", "membershipStatus", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Library staff or manager account record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "staffCode": { "type": "string", "maxLength": 24 },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "mobile": { "type": "string", "minLength": 7, "maxLength": 20 },
        "role": { "type": "string", "enum": ["staff", "manager"] },
        "permissions": { "type": "array" },
        "shift": { "type": "string", "maxLength": 60 },
        "monthlySalary": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffCode", "fullName", "email", "mobile", "role", "permissions", "shift", "monthlySalary", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "MembershipPlan": {
      "title": "MembershipPlan",
      "description": "Configurable library subscription plan.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "durationDays": { "type": "integer" },
        "price": { "type": "number" },
        "timings": { "type": "string", "maxLength": 100 },
        "seatAccess": { "type": "string", "maxLength": 120 },
        "facilities": { "type": "array" },
        "terms": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "durationDays", "price", "timings", "seatAccess", "facilities", "terms", "active", "isDemo", "createdAt", "updatedAt"]
    },
    "Membership": {
      "title": "Membership",
      "description": "Student subscription record linking student to plan and expiry.",
      "type": "object",
      "properties": {
        "studentDocId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "planId": { "type": "string", "maxLength": 128 },
        "planName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 40 },
        "expiryDate": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["active", "expired", "pending", "cancelled"] },
        "paymentId": { "type": "string", "maxLength": 128 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentDocId", "studentUid", "studentCode", "studentName", "planId", "planName", "amount", "startDate", "expiryDate", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Seat": {
      "title": "Seat",
      "description": "Physical study seat with zone, grid position, and real-time occupancy state.",
      "type": "object",
      "properties": {
        "seatCode": { "type": "string", "maxLength": 16 },
        "zone": { "type": "string", "maxLength": 60 },
        "rowLabel": { "type": "string", "maxLength": 8 },
        "colIndex": { "type": "integer" },
        "status": { "type": "string", "enum": ["available", "occupied", "reserved", "maintenance"] },
        "assignedStudentDocId": { "type": "string", "maxLength": 128 },
        "assignedStudentUid": { "type": "string", "maxLength": 128 },
        "assignedStudentCode": { "type": "string", "maxLength": 24 },
        "shift": { "type": "string", "maxLength": 60 },
        "isDemo": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seatCode", "zone", "rowLabel", "colIndex", "status", "isDemo", "updatedAt"]
    },
    "SeatBooking": {
      "title": "SeatBooking",
      "description": "Seat booking, change, or cancellation request.",
      "type": "object",
      "properties": {
        "seatId": { "type": "string", "maxLength": 128 },
        "seatCode": { "type": "string", "maxLength": 16 },
        "studentDocId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "bookingType": { "type": "string", "enum": ["new", "change"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "cancelled", "released"] },
        "notes": { "type": "string", "maxLength": 400 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seatId", "seatCode", "studentDocId", "studentUid", "studentCode", "studentName", "bookingType", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Student daily check-in and check-out record with duration and method.",
      "type": "object",
      "properties": {
        "studentDocId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "date": { "type": "string", "maxLength": 20 },
        "checkInTime": { "type": "string", "maxLength": 40 },
        "checkOutTime": { "type": "string", "maxLength": 40 },
        "durationMinutes": { "type": "integer" },
        "method": { "type": "string", "enum": ["qr", "manual", "id"] },
        "isLate": { "type": "boolean" },
        "markedBy": { "type": "string", "maxLength": 128 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentDocId", "studentUid", "studentCode", "studentName", "date", "checkInTime", "durationMinutes", "method", "isLate", "isDemo", "createdAt", "updatedAt"]
    },
    "BookCategory": {
      "title": "BookCategory",
      "description": "Book inventory category classification.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "shelfRange": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "shelfRange", "createdAt"]
    },
    "Book": {
      "title": "Book",
      "description": "Library book inventory record.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "minLength": 1, "maxLength": 150 },
        "publisher": { "type": "string", "maxLength": 150 },
        "isbn": { "type": "string", "maxLength": 32 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "totalCopies": { "type": "integer" },
        "availableCopies": { "type": "integer" },
        "shelfNumber": { "type": "string", "maxLength": 32 },
        "publicationYear": { "type": "integer" },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "author", "isbn", "categoryName", "totalCopies", "availableCopies", "shelfNumber", "publicationYear", "isDemo", "createdAt", "updatedAt"]
    },
    "BookIssue": {
      "title": "BookIssue",
      "description": "Book issue, request, return, and fine tracking record.",
      "type": "object",
      "properties": {
        "bookId": { "type": "string", "maxLength": 128 },
        "bookTitle": { "type": "string", "maxLength": 200 },
        "studentDocId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "issueDate": { "type": "string", "maxLength": 40 },
        "dueDate": { "type": "string", "maxLength": 40 },
        "returnDate": { "type": "string", "maxLength": 40 },
        "fineAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["requested", "issued", "returned", "overdue", "rejected"] },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookId", "bookTitle", "studentDocId", "studentUid", "studentCode", "studentName", "fineAmount", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Membership fee and fine payment transaction.",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string", "maxLength": 40 },
        "studentDocId": { "type": "string", "maxLength": 128 },
        "studentUid": { "type": "string", "maxLength": 128 },
        "studentCode": { "type": "string", "maxLength": 24 },
        "studentName": { "type": "string", "maxLength": 120 },
        "planId": { "type": "string", "maxLength": 128 },
