        "notes": { "type": "string", "maxLength": 400 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["receiptNumber", "studentDocId", "studentUid", "studentCode", "studentName", "planName", "amount", "method", "status", "isDemo", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Library operating expense entry.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 150 },
        "category": { "type": "string", "enum": ["electricity", "rent", "internet", "salary", "maintenance", "furniture", "other"] },
        "amount": { "type": "number" },
        "expenseDate": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 400 },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "amount", "expenseDate", "recordedBy", "isDemo", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification and delivery channel record.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["membership_expiry", "payment_confirmation", "payment_pending", "seat_allocation", "seat_change", "attendance_confirmation", "book_return", "announcement"] },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 600 },
        "read": { "type": "boolean" },
        "channel": { "type": "string", "enum": ["in_app", "whatsapp", "email", "sms"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "type", "title", "message", "read", "channel", "createdAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
