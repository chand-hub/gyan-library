# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model configuration (defaults to gemini-4-hydrogen)
# GEMINI_MODEL="gemini-4-hydrogen"
# Optional verified fallback model (only used after models.get validation)
# GEMINI_FALLBACK_MODEL=""

# Optional Vite dev HMR override ("true" to disable or enable explicitly)
# DISABLE_HMR="true"
# ENABLE_HMR="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Client-side public key restricted to HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY=""

# Razorpay Merchant Credentials (Server-side only for SECRET; KEY_ID is public)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional Notification Providers (Server-side only)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMS_API_KEY=""
