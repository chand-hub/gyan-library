          </label>

          <button type="submit" class="w-full inline-flex items-center justify-center px-gutter-lg py-3 rounded bg-secondary text-on-secondary hover:bg-primary font-label text-label-lg transition-colors duration-state-change cursor-pointer mt-2">
            Sign in to portal
          </button>
        </form>
      </div>
    </main>
  </div>

  <script>
    (function () {
      var tabs = document.querySelectorAll('[data-auth-tab]');
      var reg = document.getElementById('panel-register');
      var log = document.getElementById('panel-login');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-auth-tab');
          tabs.forEach(function (t) {
            var active = t.getAttribute('data-auth-tab') === target;
            t.setAttribute('aria-selected', active ? 'true' : 'false');
            t.classList.toggle('bg-surface-container-lowest', active);
            t.classList.toggle('text-primary', active);
            t.classList.toggle('shadow-sm', active);
            t.classList.toggle('text-on-surface-variant', !active);
          });
          if (target === 'register') {
            reg.classList.remove('hidden'); reg.classList.add('flex');
            log.classList.add('hidden'); log.classList.remove('flex');
          } else {
            log.classList.remove('hidden'); log.classList.add('flex');
            reg.classList.add('hidden'); reg.classList.remove('flex');
          }
        });
      });
    })();
